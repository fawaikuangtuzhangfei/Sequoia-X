data/*.gz
data/*.zip

# 环境变量
.env

# 打包构建
*.egg-info/
dist/
build/

# 测试与工具缓存
.pytest_cache/
.ruff_cache/

# 日志
*.log

# Hypothesis 测试缓存
.hypothesis/
